# Chat API: поиск собеседника и диалоги для ботов и сайта.
# Сервисный токен бота ВК, не короче 16 символов. На сервере deploy/update.sh создаст его сам.
# Тот же секрет нужно прописать в репозитории dating-bot-vk.
CHAT_API_SERVICE_TOKEN=local-service-token-change-me
# Токен Cloudflare Worker сайта (landing/worker): действует только за пользователей платформы web.
# Не короче 16 символов и не совпадает с CHAT_API_SERVICE_TOKEN. На сервере берётся из секрета.
CHAT_API_APP_TOKEN=local-app-token-change-me
# Токен engine_bridge: действует только за аккаунты chat-engine. На сервере deploy/update.sh создаст его сам.
# Без него люди ищут только друг друга.
# CHAT_API_ENGINE_TOKEN=local-engine-token-change-me
# Через сколько секунд ожидания живого собеседника человеку подбирается собеседник из chat-engine.
# ENGINE_FALLBACK_AFTER_SECONDS=0

# Токен бота Telegram: действует только за пользователей tg.
# Тот же секрет лежит в репозитории dating-bot-tg. Без него Chat API не примет бота.
# CHAT_API_TG_TOKEN=local-tg-token-change-me

# chat-engine: адрес и его API_TOKEN. Без токена сервис engine-bridge не запускается.
# CHAT_ENGINE_URL=https://bots.chatwithyou.site
# CHAT_ENGINE_TOKEN=

# Токен Cloudflare Tunnel: через него снаружи открыты Studio и Chat API. Локально не нужен.
# CLOUDFLARE_TUNNEL_TOKEN=
# Адреса для запуска бота на хосте. В Docker Compose подставляются сами.
CHAT_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
# Куда публиковать порт API на хосте. Снаружи его открывает Cloudflare Tunnel.
CHAT_API_PUBLISH=127.0.0.1:8000

# Supabase Postgres. Эти значения подходят для docker compose из этого репозитория.
# DATABASE_URL нужен Chat API, если он запускается на хосте и ходит в базу на localhost.
# Внутри Docker Compose адрес базы подставляется сам: хост db, пользователь supabase_admin.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DATABASE_URL=postgresql://supabase_admin:postgres@localhost:5432/postgres

# Образы Chat API и моста. Локально не задавайте: Compose соберёт их сам.
# На сервере CI подставляет имена из Docker Hub, в .env их писать не нужно.
# CHAT_API_IMAGE=username/dating-chat-api:sha
# ENGINE_BRIDGE_IMAGE=username/dating-engine-bridge:sha

# S3 Beget: фото, видео, кружки и голосовые сохраняются в бакет до пересылки собеседнику.
# Без любого из значений Chat API работает, а загрузка медиа отвечает 503.
# S3_ENDPOINT_URL=https://s3.ru1.storage.beget.cloud
# S3_REGION=ru1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Локальная панель Studio: http://127.0.0.1:54323. На сервере адрес задаёт deploy/update.sh.
# STUDIO_PUBLIC_URL=https://studio.chatwithyou.site
# Ключ шифрует строки подключения, которые Studio передаёт в postgres-meta.
PG_META_CRYPTO_KEY=local-studio-crypto-key-32-characters
STUDIO_DEFAULT_ORGANIZATION=VK Bot
STUDIO_DEFAULT_PROJECT=vk-bot

# Страница оплаты премиума (premium_site, docker-compose.payments.yml). Реальные значения — только в секретах сервера.
# Секрет подписи ссылок на оплату из чатов, не короче 32 символов. Одинаковый у chat-api и premium_site.
# Без него chat-api отвечает 503 на .../premium/link, а страница оплаты пускает только по email.
PREMIUM_LINK_SECRET=
PAY_PUBLIC_URL=https://pay.chatwithyou.site
PAY_SECURE_COOKIE=true
# Не короче 32 символов: подпись кодов входа по email.
PAY_AUTH_SECRET=
RESEND_API_KEY=
AUTH_MAIL_FROM=neon chat <noreply@chatwithyou.site>
# Токены ботов для /internal/peers/... страницы оплаты, не короче 32 символов и разные.
PREM_SERVICE_VK_TOKEN=
PREM_SERVICE_TG_TOKEN=
PREM_SERVICE_WEB_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
# receipt или exempt; для receipt нужны YOOKASSA_VAT_CODE и YOOKASSA_PAYMENT_SUBJECT.
YOOKASSA_RECEIPT_MODE=
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=
# Необязательный список IP/CIDR уведомлений ЮKassa через запятую; пусто — проверка выключена.
# Актуальные адреса — в документации ЮKassa (раздел про входящие уведомления).
YOOKASSA_WEBHOOK_IPS=
# Куда публиковать порт страницы оплаты на хосте.
# PREMIUM_PUBLISH=127.0.0.1:18080
# PREMIUM_IMAGE=dating-premium:local
# Кому страница оплаты верит в X-Forwarded-For (адреса через запятую), по умолчанию 127.0.0.1.
# Без этого за прокси все клиенты выглядят как один адрес шлюза Docker и делят лимит писем по IP.
# Укажите адрес прокси хоста или шлюза Docker, как его видит контейнер. Прокси обязан перезаписывать
# X-Forwarded-For адресом клиента (nginx: proxy_set_header X-Forwarded-For $remote_addr), а не дописывать.
# За Cloudflare прокси должен брать настоящий IP из заголовка, который ставит Cloudflare (CF-Connecting-IP).
# Не ставьте "*": клиент подделает свой IP и обойдёт лимит писем и список IP вебхука.
# На сервере deploy/update.sh сам ставит подсеть сети Compose (через неё ходит cloudflared), если значение не задано в ENV_FILE.
# PREMIUM_FORWARDED_ALLOW_IPS=127.0.0.1
